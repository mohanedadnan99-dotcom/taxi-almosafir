# Keep real values only in Vercel Environment Variables.
TELEGRAM_BOT_TOKEN=(bot token)
TELEGRAM_CHAT_ID=(Telegram group/chat id)

# Preferred persistent order database (server-side only).
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SECRET_KEY=(sb_secret server key)
# Legacy alternative if the project still uses it:
# SUPABASE_SERVICE_ROLE_KEY=(legacy service_role key)

# Optional fallback storage. If Supabase is configured, Supabase is preferred.
BLOB_READ_WRITE_TOKEN=(vercel blob token)

# Admin Control Center security.
# Set these before company handoff. ADMIN_PASSWORD may be used instead of the hash,
# but ADMIN_PASSWORD_SHA256 keeps the plaintext password out of environment exports.
ADMIN_USERNAME=(admin username)
ADMIN_PASSWORD_SHA256=(sha256 of admin password)
ADMIN_SESSION_SECRET=(long random secret used to sign 12-hour admin sessions)
